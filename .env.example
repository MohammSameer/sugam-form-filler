# Copy to .env and fill in your key.  NEVER commit .env.
# Get a key: https://aistudio.google.com/apikey

# ---- Required --------------------------------------------------------------
GOOGLE_API_KEY=your-gemini-api-key-here

# Gemini API key auth (not Vertex AI). Leave as False.
GOOGLE_GENAI_USE_VERTEXAI=False

# ---- Model ------------------------------------------------------------------
# The primary model. The 1.5 family is retired and returns 404.
GEMINI_MODEL=gemini-2.5-flash

# Comma-separated chain to fail over to when the primary's free-tier quota is
# exhausted (429) or the model name is unavailable on this key (404). Leave the
# default and a spent daily quota degrades to flash-lite instead of stranding the
# user mid-form. Set to an empty value to disable failover.
GEMINI_MODEL_FALLBACKS=gemini-2.5-flash-lite

# ---- Optional: server-side speech (web UI "Listen") -------------------------
# Only used for languages the browser has no on-device voice for (Tamil, Telugu,
# Kannada, Gujarati, Punjabi, Urdu). English/Hindi never reach the server.
# GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
# GEMINI_TTS_VOICE=Kore

# ---- Optional: OCR for scanned/photographed forms ---------------------------
# Path to the Tesseract binary. Only needed if it is not on PATH and not at the
# default Windows location (C:\Program Files\Tesseract-OCR\tesseract.exe).
# Without Tesseract the uploaded-form fill still works — it uses the vision path.
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# ---- Optional: web server bind (app/server.py) ------------------------------
# HOST=127.0.0.1
# PORT=8000
